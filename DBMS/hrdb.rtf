\f0\fs24 \cf0 -- Create a new database named 'hrdb'\
CREATE DATABASE hrdb;\
\
-- Switch to the newly created database\
USE hrdb;\
\
-- Table to store high-level regions (e.g., Asia, Europe)\
CREATE TABLE REGIONS (\
    region_id INT PRIMARY KEY AUTO_INCREMENT,\
    region_name VARCHAR(25)\
);\
\
-- Set the starting ID for regions to 100\
ALTER TABLE REGIONS AUTO_INCREMENT=100;\
\
-- Populate Region data\
INSERT INTO REGIONS (region_name) VALUES \
('Europe'), ('Americas'), ('Asia'), ('Middle East and Africa'), ('Oceania');\
\
-- Table to store countries, linked to a specific region\
CREATE TABLE COUNTRIES (\
    country_id INT PRIMARY KEY AUTO_INCREMENT,\
    country_name VARCHAR(40),\
    region_id INT,\
    FOREIGN KEY (region_id) REFERENCES REGIONS(region_id)\
);\
\
-- Set starting ID for countries to 1000\
ALTER TABLE COUNTRIES AUTO_INCREMENT=1000;\
\
-- Drop standard FK and re-add with CASCADE logic for automatic cleanup\
ALTER TABLE COUNTRIES DROP FOREIGN KEY countries_ibfk_1;\
ALTER TABLE COUNTRIES \
ADD CONSTRAINT fk_countries_regions \
FOREIGN KEY (region_id) REFERENCES REGIONS(region_id) ON DELETE CASCADE;\
\
-- Populate Country data linked to Region IDs\
INSERT INTO COUNTRIES (country_name, region_id) VALUES \
('United Kingdom', 100), ('United States', 101), ('India', 102), ('Canada', 101), ('Germany', 100);\
\
-- Table for physical office addresses\
CREATE TABLE LOCATIONS (\
    location_id INT PRIMARY KEY AUTO_INCREMENT,\
    street_address VARCHAR(40),\
    postal_code VARCHAR(12),\
    city VARCHAR(30) NOT NULL,\
    state_province VARCHAR(25),\
    country_id INT,\
    FOREIGN KEY (country_id) REFERENCES COUNTRIES(country_id)\
);\
\
-- Set starting ID for locations to 500\
ALTER TABLE LOCATIONS AUTO_INCREMENT=500;\
\
-- Link Locations to Countries\
INSERT INTO LOCATIONS (street_address, postal_code, city, state_province, country_id) VALUES \
('1297 Via Cola di Rie', '00989', 'Roma', 'Lazio', 1000),\
('9702 Chester Road', '96298', 'Stretford', 'Manchester', 1000),\
('2014 Jabberwocky Rd', '80209', 'Southlake', 'Texas', 1001),\
('2011 Interiors Blvd', '99236', 'South San Francisco', 'California', 1001),\
('Schwanthalerstr. 7031', '80925', 'Munich', 'Bavaria', 1004);\
\
-- Table for internal company departments\
CREATE TABLE DEPARTMENTS (\
    department_id INT PRIMARY KEY AUTO_INCREMENT,\
    department_name VARCHAR(30) NOT NULL,\
    manager_id INT,\
    location_id INT,\
    FOREIGN KEY (location_id) REFERENCES LOCATIONS(location_id)\
);\
\
-- Set starting ID for departments to 2000\
ALTER TABLE DEPARTMENTS AUTO_INCREMENT=2000;\
\
-- Populate Departments (Managers will be assigned via UPDATE after Employees exist)\
INSERT INTO DEPARTMENTS (department_name, location_id) VALUES \
('Administration', 500), ('Marketing', 501), ('Purchasing', 502), ('Human Resources', 503), ('IT', 503);\
\
-- Table for job roles and their salary brackets\
CREATE TABLE JOBS (\
    job_id INT PRIMARY KEY AUTO_INCREMENT,\
    job_title VARCHAR(35) NOT NULL,\
    min_salary DECIMAL(8,2),\
    max_salary DECIMAL(8,2)\
);\
\
-- Set starting ID for jobs to 700\
ALTER TABLE JOBS AUTO_INCREMENT=700;\
\
-- Populate Job roles\
INSERT INTO JOBS (job_title, min_salary, max_salary) VALUES \
('Public Accountant', 4200, 9000),\
('Administration Assistant', 3000, 6000),\
('President', 20000, 40000),\
('Programmer', 4000, 10000),\
('Account Manager', 8200, 16000);\
\
-- The central table containing all staff information\
CREATE TABLE EMPLOYEES (\
    employee_id INT PRIMARY KEY AUTO_INCREMENT,\
    first_name VARCHAR(20),\
    last_name VARCHAR(25) NOT NULL,\
    email VARCHAR(25) NOT NULL,\
    phone_number VARCHAR(20),\
    hire_date DATE NOT NULL,\
    job_id  INT,\
    salary DECIMAL(8,2),\
    commission_pct DECIMAL(2,2),\
    manager_id INT,\
    department_id INT,\
    FOREIGN KEY (job_id) REFERENCES JOBS(job_id),\
    FOREIGN KEY (department_id) REFERENCES DEPARTMENTS(department_id),\
    FOREIGN KEY (manager_id) REFERENCES EMPLOYEES(employee_id)\
);\
\
-- Set starting ID for employees to 50\
ALTER TABLE EMPLOYEES AUTO_INCREMENT=50;\
\
-- Enforce unique contact information\
ALTER TABLE EMPLOYEES ADD CONSTRAINT UNIQUE (email);\
ALTER TABLE EMPLOYEES ADD CONSTRAINT UNIQUE (phone_number);\
\
