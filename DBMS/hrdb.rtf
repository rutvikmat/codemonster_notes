\
-- Set the reporting hierarchy (Who reports to whom)\
UPDATE EMPLOYEES SET manager_id = 50 WHERE employee_id IN (51, 52);\
UPDATE EMPLOYEES SET manager_id = 51 WHERE employee_id IN (53, 54);\
\
-- Assign Department Managers\
UPDATE DEPARTMENTS SET manager_id = 50 WHERE department_id = 2000;\
UPDATE DEPARTMENTS SET manager_id = 53 WHERE department_id = 2004;\
\
-- Table to track movements between jobs/departments over time\
CREATE TABLE JOB_HISTORY (\
    employee_id INT AUTO_INCREMENT,\
    start_date DATE,\
    end_date DATE NOT NULL,\
    job_id INT,\
    department_id INT,\
    PRIMARY KEY (employee_id, start_date),\
    FOREIGN KEY (employee_id) REFERENCES EMPLOYEES(employee_id),\
    FOREIGN KEY (job_id) REFERENCES JOBS(job_id),\
    FOREIGN KEY (department_id) REFERENCES DEPARTMENTS(department_id)\
);\
\
-- Generate a report showing employees with their job titles, departments, and cities\
SELECT \
    e.first_name, e.last_name, j.job_title, d.department_name, l.city\
FROM EMPLOYEES e\
JOIN JOBS j ON e.job_id = j.job_id\
JOIN DEPARTMENTS d ON e.department_id = d.department_id\
JOIN LOCATIONS l ON d.location_id = l.location_id;}